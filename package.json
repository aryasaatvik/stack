{
  "name": "@aryasaatvik/stack",
  "version": "0.5.1",
  "description": "Squash-safe stacked PR/MR repair CLI for GitHub and GitLab",
  "keywords": [
    "cli",
    "git",
    "github",
    "gitlab",
    "merge-requests",
    "node",
    "pull-requests",
    "stacked-prs"
  ],
  "homepage": "https://github.com/aryasaatvik/stack#readme",
  "bugs": {
    "url": "https://github.com/aryasaatvik/stack/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryasaatvik/stack.git"
  },
  "bin": {
    "stack": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run dev/build-cli.ts",
    "dev": "bun src/cli.ts status",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "package:smoke": "bun run build && npm pack --dry-run",
    "prepack": "bun run build",
    "tegami": "bun scripts/tegami.mts",
    "version:packages": "bun run tegami version",
    "release:check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run package:smoke",
    "release": "bun run release:check && bun run tegami publish",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.64",
    "effect": "4.0.0-beta.64"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.64",
    "@types/bun": "latest",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "tegami": "1.2.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
